[Unit]
Description=V8 market sync and strategy evaluation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/v8_project
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/v8_project/.venv/bin/python oracle_strategy_job.py
RuntimeMaxSec=12min
Nice=10
IOSchedulingClass=idle

# The job only needs its project directory and network access.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/v8_project/data /opt/v8_project/runtime

[Install]
WantedBy=multi-user.target
