[Unit]
Description=Market sync and strategy backtest evaluation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/v8_project
Environment=PYTHONUNBUFFERED=1
Environment=STRATEGY=nfe-v2
Environment=RISK_PCT=0.05
Environment=MAX_LEVERAGE=1000
Environment=START_AT=2026-07-01T00:00:00Z
ExecStart=/opt/v8_project/.venv/bin/python oracle_strategy_job.py --strategy ${STRATEGY} --risk-pct ${RISK_PCT} --max-leverage ${MAX_LEVERAGE} --start-at ${START_AT}
TimeoutStartSec=12min
Nice=10
IOSchedulingClass=idle

# The job only needs its project directory and network access.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/v8_project/data /opt/v8_project/runtime

[Install]
WantedBy=multi-user.target
