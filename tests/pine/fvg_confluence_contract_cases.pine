// Cases are literal expectations from the 1.0A specification, not OHLC backtests.
f_assert(bool condition, string name) =>
    if not condition
        runtime.error("FAIL: " + name)
    1

f_state(int state, int touched, int dir, int n, int window, bool eligible, bool confirmed, float o, float h, float l, float c, float width, float displacement, float wick) =>
    [s, t, br, wr] = f_step(state, touched, dir, 100.0, 120.0, width, n, window, eligible, confirmed, o, h, l, c, displacement, wick)
    s

var table result = table.new(position.top_right, 1, 2)
var array<string> retainedTimes = array.new<string>()
var array<string> retainedKinds = array.new<string>()
var array<string> retainedSources = array.new<string>()
var array<string> retainedZones = array.new<string>()
var array<string> retainedReasons = array.new<string>()
if barstate.islast
    int passed = 0
    // Touch candle is #1; candle #96 is the last eligible key candle.
    passed += f_assert(f_state(1, 100, 1, 195, 96, true, true, 110, 112, 108, 110, 100, 0.5, 0.2) == 3, "expiry at close of candle 96")
    passed += f_assert(f_precedes(1, 110, 1, 110, 2), "equal-price zones have stable distinct ranks")
    passed += f_assert(f_state(1, 100, 1, 195, 96, true, true, 110, 171, 108, 170, 100, 0.5, 0.2) == 4, "key allowed on candle 96")
    passed += f_assert(f_state(1, 100, 1, 196, 96, true, true, 110, 171, 108, 170, 100, 0.5, 0.2) == 3, "key rejected on candle 97")
    passed += f_assert(f_state(1, 100, 1, 194, 96, true, true, 110, 112, 108, 110, 100, 0.5, 0.2) == 1, "candle 95 stays observing")
    passed += f_assert(f_state(0, na, 1, 100, 96, true, true, 105, 110, 90, 101, 100, 0.5, 0.2) == 1, "bull wick-through stays valid")
    passed += f_assert(f_state(0, na, -1, 100, 96, true, true, 115, 130, 110, 119, 100, 0.5, 0.2) == 1, "bear wick-through stays valid")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 40, 100, 39, 99, 100, 0.5, 0.2) == 2, "bull close invalidation overrides strong bullish key")
    passed += f_assert(f_state(1, 100, -1, 101, 96, true, true, 180, 181, 120, 121, 100, 0.5, 0.2) == 2, "bear close invalidation overrides strong bearish key")
    passed += f_assert(f_state(0, na, 1, 100, 96, true, true, 100, 110, 90, 100, 100, 0.5, 0.2) == 1, "close exactly on bull boundary is valid")
    passed += f_assert(f_state(0, na, -1, 100, 96, true, true, 120, 130, 110, 120, 100, 0.5, 0.2) == 1, "close exactly on bear boundary is valid")
    passed += f_assert(f_state(0, na, 1, 100, 96, true, false, 40, 100, 39, 99, 100, 0.5, 0.2) == 0, "unfinished candle does not invalidate or touch")
    passed += f_assert(f_state(0, na, 1, 100, 96, true, true, 125, 130, 121, 125, 100, 0.5, 0.2) == 0, "no intersection means no touch")
    passed += f_assert(f_state(0, na, 1, 100, 96, false, true, 110, 120, 100, 110, 100, 0.5, 0.2) == 0, "no touch before eligibility")
    [firstState, firstTouch, firstBody, firstWick] = f_step(0, na, 1, 100, 120, 100, 100, 96, true, true, 110, 120, 100, 110, 0.5, 0.2)
    [secondState, secondTouch, secondBody, secondWick] = f_step(firstState, firstTouch, 1, 100, 120, 100, 120, 96, true, true, 110, 120, 100, 110, 0.5, 0.2)
    passed += f_assert(firstState == 1 and firstTouch == 100 and secondState == 1 and secondTouch == 100, "later touch never resets clock")
    passed += f_assert(f_state(0, na, 1, 100, 1, true, true, 110, 120, 100, 110, 100, 0.5, 0.2) == 3, "one-bar window expires on touch close")
    passed += f_assert(f_state(0, na, 1, 100, 1, true, true, 110, 171, 100, 170, 100, 0.5, 0.2) == 4, "eligible touch candle can also be key")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 170, 180, 100, 110, 100, 0.5, 0.2) == 1, "wrong-direction candle rejected")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 110, 110, 110, 110, 100, 0.5, 0.2) == 1, "zero-range doji rejected")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 110, 171, 108, 170, 0, 0.5, 0.2) == 1, "zero-width parent rejected")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 120, 180, 100, 170, 100, 0.3, 0.2) == 4, "30 percent displacement passes")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 120, 180, 100, 170, 100, 0.5, 0.2) == 4, "50 percent displacement boundary passes")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 120, 180, 100, 170, 100, 0.7, 0.2) == 1, "70 percent displacement fails: use parent width not candle range")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 110, 200, 100, 180, 100, 0.7, 0.2) == 4, "70 percent displacement equality passes")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 110, 200, 100, 180, 100, 0.5, 0.1) == 1, "10 percent wick rejects 20 percent")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 110, 200, 100, 180, 100, 0.5, 0.2) == 4, "20 percent wick equality passes")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 110, 200, 100, 180, 100, 0.5, 0.3) == 4, "30 percent wick allows 20 percent")
    passed += f_assert(f_state(1, 100, 1, 101, 96, true, true, 120, 170, 0, 170, 100, 0.5, 0.1) == 4, "opposite wick is unrestricted for bull")
    passed += f_assert(f_state(1, 100, -1, 101, 96, true, true, 170, 300, 110, 110, 100, 0.5, 0.1) == 4, "opposite wick is unrestricted for bear")
    passed += f_assert(f_state(1, 100, -1, 101, 96, true, true, 170, 180, 50, 110, 100, 0.5, 0.2) == 1, "bear forward wick is lower wick")
    passed += f_assert(f_state(4, 100, 1, 110, 96, true, true, 110, 120, 90, 90, 100, 0.5, 0.2) == 4, "completed key does not emit again")
    passed += f_assert(f_state(2, 100, 1, 110, 96, true, true, 110, 171, 108, 170, 100, 0.5, 0.2) == 2, "invalid zone does not revive")
    passed += f_assert(f_state(3, 100, 1, 110, 96, true, true, 110, 171, 108, 170, 100, 0.5, 0.2) == 3, "expired zone does not revive")
    [bull, bullBottom, bullTop] = f_gap(150, 130, 120, 100)
    passed += f_assert(bull == 1 and bullBottom == 120 and bullTop == 130, "bull FVG bounds")
    [bear, bearBottom, bearTop] = f_gap(90, 70, 120, 100)
    passed += f_assert(bear == -1 and bearBottom == 90 and bearTop == 100, "bear FVG bounds")
    [noGap, noBottom, noTop] = f_gap(140, 120, 120, 100)
    passed += f_assert(noGap == 0, "equal edges are not an FVG")
    [overlap, overlapBottom, overlapTop] = f_overlap(100, 140, 120, 160)
    passed += f_assert(overlap and overlapBottom == 120 and overlapTop == 140, "intersection bounds")
    [edgeOnly, edgeBottom, edgeTop] = f_overlap(100, 120, 120, 140)
    passed += f_assert(not edgeOnly, "touching FVG edges alone are not an overlap")
    [separate, separateBottom, separateTop] = f_overlap(100, 120, 130, 140)
    passed += f_assert(not separate, "disjoint FVGs rejected")
    passed += f_assert(f_precedes(1, 100, 3, 110, 1), "lower bull zone ranks first")
    passed += f_assert(f_precedes(-1, 120, 3, 110, 1), "higher bear zone ranks first")
    passed += f_assert(not f_precedes(1, 110, 2, 110, 1), "tie ordering is asymmetric")
    passed += f_assert(f_precedes(-1, 110, 1, 110, 2), "bear price ties ordered by creation")
    passed += f_assert(f_wait_end(0, 194, 100, 96, true) == 0, "untouched setup waits through candle 95")
    passed += f_assert(f_wait_end(0, 195, 100, 96, true) == 5, "untouched setup expires at candle 96 close")
    passed += f_assert(f_wait_end(0, 195, 100, 96, false) == 0, "open candle cannot expire waiting setup")
    passed += f_assert(f_wait_end(1, 195, 100, 96, true) == 1, "touch on last waiting candle starts independent observation")
    passed += f_assert(f_wait_end(4, 195, 100, 96, true) == 4, "key on last waiting candle overrides waiting expiry")
    passed += f_assert(f_keep_source(false, false, 194, 100, 96), "unlocked source remains eligible before deadline")
    passed += f_assert(not f_keep_source(false, false, 195, 100, 96), "unlocked source expires without being filled")
    passed += f_assert(not f_keep_source(true, false, 110, 100, 96), "source retires when last child terminates")
    passed += f_assert(f_keep_source(true, true, 110, 100, 96), "shared source remains while another child is active")
    passed += f_assert(f_can_pair(195, 100, 96), "source can pair on last allowed candle")
    passed += f_assert(not f_can_pair(196, 100, 96), "new children cannot indefinitely renew source lifetime")
    passed += f_assert(f_direction_allowed(false, true), "veto OFF permits setup after opposite FVG")
    passed += f_assert(not f_direction_allowed(true, true), "veto ON blocks new setup after opposite FVG")
    passed += f_assert(f_direction_allowed(true, false), "same-direction setup allowed before opposite FVG")
    for eventNo = 0 to 10
        string eventText = str.tostring(eventNo)
        f_push_failure(retainedTimes, retainedKinds, retainedSources, retainedZones, retainedReasons, eventText, eventText, eventText, eventText, eventText)
    passed += f_assert(array.size(retainedTimes) == 10 and array.get(retainedTimes, 0) == "1" and array.get(retainedTimes, 9) == "10" and array.size(retainedKinds) == 10 and array.size(retainedSources) == 10 and array.size(retainedZones) == 10 and array.size(retainedReasons) == 10, "failure audit keeps only latest ten synchronized entries")
    table.cell(result, 0, 0, "PASS: " + str.tostring(passed) + " cases", bgcolor=color.teal, text_color=color.white)
    table.cell(result, 0, 1, "Synthetic Pine contract checks", text_color=color.teal)
